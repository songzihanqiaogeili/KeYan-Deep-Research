# Copy to .env.scientific. Explicit PowerShell environment variables override this file.
# Local Ollama does not require a paid API key; "ollama" is a placeholder.
SCIENTIFIC_LLM_API_KEY=ollama
SCIENTIFIC_LLM_BASE_URL=http://127.0.0.1:11434/v1
SCIENTIFIC_LLM_MODEL=qwen3.5:4b
SCIENTIFIC_LLM_TIMEOUT=180

# Existing local model only; never auto-downloads. Leave blank for BM25 only.
SCIENTIFIC_EMBEDDING_MODEL=bge-m3:latest
SCIENTIFIC_EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Optional cloud observation. Defaults to no remote traces.
# Only hashes/counts/actual usage are sent; source and prompt text stay local.
SCIENTIFIC_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scientific-research
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
